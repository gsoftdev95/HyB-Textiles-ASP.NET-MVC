@model pe.com.HyBTextiles.mvc.Models.MantenimientoMaquina

@{
    ViewBag.Title = "Habilitación de MantenimientoMaquina";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4"><div class="card shadow border-0">
    <div class="card-header bg-warning text-white"><h4 class="mb-0">Habilitación de MantenimientoMaquina</h4></div>
    <div class="card-body">
        <div class="alert alert-warning">¿Estás seguro que deseas habilitar este registro?</div>
        <dl class="row">
            <dt class="col-sm-3">Código</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.codmnt)</dd>
            <dt class="col-sm-3">Máquina</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.codmaq)</dd>
            <dt class="col-sm-3">Fecha Mantenimiento</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.fecmnt)</dd>
            <dt class="col-sm-3">Descripción</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.descmnt)</dd>
            <dt class="col-sm-3">Costo</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.costmnt)</dd>
            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">@(Model.estmnt ? "Habilitado" : "Deshabilitado")</dd>
        </dl>
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <div class="d-flex justify-content-between">
                <button type="submit" class="btn btn-warning">Habilitar</button>
                @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-dark" })
            </div>
        }
    </div>
    <div class="card-footer text-muted text-center">HyB Textiles - MantenimientoMaquina</div>
</div></div>