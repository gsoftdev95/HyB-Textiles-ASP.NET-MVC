@model pe.com.HyBTextiles.mvc.Models.Pedido

@{
    ViewBag.Title = "Actualizar Pedido";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center"><div class="col-md-8">
        <div class="card shadow border-0">
            <div class="card-header bg-success text-white"><h4 class="mb-0">Actualizar Pedido</h4></div>
            <div class="card-body">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                    @Html.HiddenFor(model => model.codped)
                        <div class="mb-3">
                            @Html.LabelFor(model => model.fecped, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.EditorFor(model => model.fecped, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.fecped, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.codcli, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.DropDownList("codcli", (SelectList)ViewBag.codcli, "-- Seleccione --", new { @class = "form-select" })
                            @Html.ValidationMessageFor(model => model.codcli, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.codest, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.DropDownList("codest", (SelectList)ViewBag.codest, "-- Seleccione --", new { @class = "form-select" })
                            @Html.ValidationMessageFor(model => model.codest, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.codusu, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.DropDownList("codusu", (SelectList)ViewBag.codusu, "-- Seleccione --", new { @class = "form-select" })
                            @Html.ValidationMessageFor(model => model.codusu, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.codmon, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.DropDownList("codmon", (SelectList)ViewBag.codmon, "-- Seleccione --", new { @class = "form-select" })
                            @Html.ValidationMessageFor(model => model.codmon, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.totped, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.EditorFor(model => model.totped, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.totped, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.estped, htmlAttributes: new { @class = "form-label fw-bold" })
                            <div class="form-check form-switch">
                                @Html.CheckBoxFor(model => model.estped, new { @class = "form-check-input" })
                                <label class="form-check-label">Habilitado</label>
                            </div>
                        </div>
                    <div class="d-flex justify-content-between mt-3">
                        <button type="submit" class="btn btn-success">Actualizar Pedido</button>
                        @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-dark" })
                    </div>
                }
            </div>
            <div class="card-footer text-muted text-center">HyB Textiles - Pedido</div>
        </div>
    </div></div>
</div>