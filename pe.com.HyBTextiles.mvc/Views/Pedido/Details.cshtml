@model pe.com.HyBTextiles.mvc.Models.Pedido

@{
    ViewBag.Title = "Detalle de Pedido";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4"><div class="card shadow border-0">
    <div class="card-header bg-dark text-white"><h4 class="mb-0">Detalle de Pedido</h4></div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Código</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.codped)</dd>
            <dt class="col-sm-3">Fecha Pedido</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.fecped)</dd>
            <dt class="col-sm-3">Cliente</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.codcli)</dd>
            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.codest)</dd>
            <dt class="col-sm-3">Usuario</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.codusu)</dd>
            <dt class="col-sm-3">Moneda</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.codmon)</dd>
            <dt class="col-sm-3">Total Pedido</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.totped)</dd>
            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">@(Model.estped ? "Habilitado" : "Deshabilitado")</dd>
        </dl>
        @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-dark" })
    </div>
    <div class="card-footer text-muted text-center">HyB Textiles - Pedido</div>
</div></div>