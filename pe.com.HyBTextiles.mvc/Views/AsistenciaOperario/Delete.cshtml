@model pe.com.HyBTextiles.mvc.Models.AsistenciaOperario

@{
    ViewBag.Title = "Eliminación de AsistenciaOperario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4"><div class="card shadow border-0">
    <div class="card-header bg-danger text-white"><h4 class="mb-0">Eliminación de AsistenciaOperario</h4></div>
    <div class="card-body">
        <div class="alert alert-danger">¿Estás seguro que deseas eliminar este registro?</div>
        <dl class="row">
            <dt class="col-sm-3">Código</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.codasi)</dd>
            <dt class="col-sm-3">Operario</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.codope)</dd>
            <dt class="col-sm-3">Turno</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.codtur)</dd>
            <dt class="col-sm-3">Fecha Asistencia</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.fecasi)</dd>
            <dt class="col-sm-3">Hora Ingreso</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.horaingasi)</dd>
            <dt class="col-sm-3">Hora Salida</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.horasaliasi)</dd>
            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">@(Model.estasi ? "Habilitado" : "Deshabilitado")</dd>
        </dl>
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <div class="d-flex justify-content-between">
                <button type="submit" class="btn btn-danger">Eliminar</button>
                @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-dark" })
            </div>
        }
    </div>
    <div class="card-footer text-muted text-center">HyB Textiles - AsistenciaOperario</div>
</div></div>