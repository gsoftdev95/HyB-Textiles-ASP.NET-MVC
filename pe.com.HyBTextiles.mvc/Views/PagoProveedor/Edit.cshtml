@model pe.com.HyBTextiles.mvc.Models.PagoProveedor

@{
    ViewBag.Title = "Actualizar PagoProveedor";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center"><div class="col-md-8">
        <div class="card shadow border-0">
            <div class="card-header bg-success text-white"><h4 class="mb-0">Actualizar PagoProveedor</h4></div>
            <div class="card-body">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                    @Html.HiddenFor(model => model.codpgp)
                        <div class="mb-3">
                            @Html.LabelFor(model => model.fecpgp, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.EditorFor(model => model.fecpgp, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.fecpgp, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.codcom, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.DropDownList("codcom", (SelectList)ViewBag.codcom, "-- Seleccione --", new { @class = "form-select" })
                            @Html.ValidationMessageFor(model => model.codcom, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.codmon, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.DropDownList("codmon", (SelectList)ViewBag.codmon, "-- Seleccione --", new { @class = "form-select" })
                            @Html.ValidationMessageFor(model => model.codmon, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.montopgp, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.EditorFor(model => model.montopgp, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.montopgp, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.estpgp, htmlAttributes: new { @class = "form-label fw-bold" })
                            <div class="form-check form-switch">
                                @Html.CheckBoxFor(model => model.estpgp, new { @class = "form-check-input" })
                                <label class="form-check-label">Habilitado</label>
                            </div>
                        </div>
                    <div class="d-flex justify-content-between mt-3">
                        <button type="submit" class="btn btn-success">Actualizar PagoProveedor</button>
                        @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-dark" })
                    </div>
                }
            </div>
            <div class="card-footer text-muted text-center">HyB Textiles - PagoProveedor</div>
        </div>
    </div></div>
</div>