@model pe.com.HyBTextiles.mvc.Models.UnidadMedida

@{
    ViewBag.Title = "Detalle de UnidadMedida";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4"><div class="card shadow border-0">
    <div class="card-header bg-dark text-white"><h4 class="mb-0">Detalle de UnidadMedida</h4></div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Código</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.codund)</dd>
            <dt class="col-sm-3">Nombre Unidad</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.nomund)</dd>
            <dt class="col-sm-3">Abreviatura</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.abrund)</dd>
            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">@(Model.estund ? "Habilitado" : "Deshabilitado")</dd>
        </dl>
        @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-dark" })
    </div>
    <div class="card-footer text-muted text-center">HyB Textiles - UnidadMedida</div>
</div></div>