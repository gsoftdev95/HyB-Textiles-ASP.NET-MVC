@model pe.com.HyBTextiles.mvc.Models.Proveedor

@{
    ViewBag.Title = "Actualizar Proveedor";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center"><div class="col-md-8">
        <div class="card shadow border-0">
            <div class="card-header bg-success text-white"><h4 class="mb-0">Actualizar Proveedor</h4></div>
            <div class="card-body">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                    @Html.HiddenFor(model => model.codprv)
                        <div class="mb-3">
                            @Html.LabelFor(model => model.rucprv, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.EditorFor(model => model.rucprv, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.rucprv, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.razonsocialprv, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.EditorFor(model => model.razonsocialprv, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.razonsocialprv, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.nomcontactoprv, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.EditorFor(model => model.nomcontactoprv, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.nomcontactoprv, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.telprv, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.EditorFor(model => model.telprv, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.telprv, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.emaprv, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.EditorFor(model => model.emaprv, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.emaprv, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.dirprv, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.EditorFor(model => model.dirprv, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.dirprv, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.estprv, htmlAttributes: new { @class = "form-label fw-bold" })
                            <div class="form-check form-switch">
                                @Html.CheckBoxFor(model => model.estprv, new { @class = "form-check-input" })
                                <label class="form-check-label">Habilitado</label>
                            </div>
                        </div>
                    <div class="d-flex justify-content-between mt-3">
                        <button type="submit" class="btn btn-success">Actualizar Proveedor</button>
                        @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-dark" })
                    </div>
                }
            </div>
            <div class="card-footer text-muted text-center">HyB Textiles - Proveedor</div>
        </div>
    </div></div>
</div>