<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> HyB Textil | @ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <style>
        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        
        .container {
            display: flex;
            flex-direction: column;
            flex: 1;
        }

        .body-content {
            flex: 1;
        }

        footer {
            background-color: #212529;
            color: #FFFFFF;
            text-align: center;
            padding: 5px 0;
            width: 100%
        }
    </style>
</head>
<body>

    <div class="container body">
        @*inicio del menu*@
        <nav class="navbar navbar-expand-lg bg-dark" data-bs-theme="dark">
            <div class="container-fluid">
                <a class="navbar-brand" href="@Url.Action("Index","Menu")">CiberElectrik</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavDropdown" aria-controls="navbarNavDropdown" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNavDropdown">
                    <ul class="navbar-nav">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Configuración </a>
                            <div class="dropdown-menu p-3" style="min-width: 420px;">
                                <div class="row">
                                    <div class="col-6">
                                        <a class="dropdown-item" href="@Url.Action("Index","Rol")">Rol</a>
                                        <a class="dropdown-item" href="@Url.Action("Index","Usuario")">Usuario</a>
                                        <a class="dropdown-item" href="@Url.Action("Index","Permiso")">Permiso</a>
                                        <a class="dropdown-item" href="@Url.Action("Index","RolPermiso")">Rol Permiso</a>
                                        <a class="dropdown-item" href="@Url.Action("Index","TipoDocumento")">Tipo Documento</a>
                                    </div>
                                </div>
                            </div>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Datos Generales </a>
                            <div class="dropdown-menu p-3" style="min-width: 420px;">
                                <a class="dropdown-item" href="@Url.Action("Index","Cliente")">Cliente</a>
                                <a class="dropdown-item" href="@Url.Action("Index","Proveedor")">Proveedor</a>
                                <a class="dropdown-item" href="@Url.Action("Index","Operario")">Operario</a>
                                <a class="dropdown-item" href="@Url.Action("Index","Moneda")">Moneda</a>
                                <a class="dropdown-item" href="@Url.Action("Index","Unidad de Medida")">Unidad de Medida</a>
                                <a class="dropdown-item" href="@Url.Action("Index","Almacen")">Almacén</a>
                                <a class="dropdown-item" href="@Url.Action("Index","Turno")">Turno</a>
                                <a class="dropdown-item" href="@Url.Action("Index","TipoHilo")">Tipo Hilo</a>
                                <a class="dropdown-item" href="@Url.Action("Index","TipoTejido")">Tipo Tejido</a>
                            </div>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Pedidos </a>
                            <div class="dropdown-menu p-3" style="min-width: 420px;">
                                <a class="dropdown-item" href="@Url.Action("Index","Pedido")">Pedido</a>
                                <a class="dropdown-item" href="@Url.Action("Index","EstadoPedido")">Estado Pedido</a>
                                <a class="dropdown-item" href="@Url.Action("Index","HistorialEstado")">Historial Estado</a>
                                <a class="dropdown-item" href="@Url.Action("Index","DocumentoPedido")">Documento Pedido</a>
                            </div>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Compras </a>
                            <div class="dropdown-menu p-3" style="min-width: 420px;">
                                <div class="row">
                                    <div class="col-6">
                                        <a class="dropdown-item" href="@Url.Action("Index","CompraProveedor")"">Compra Proveedor</a>
                                        <a class="dropdown-item" href="@Url.Action("Index","PagoProveedor")"">Pago Proveedor</a>
                                    </div>
                                </div>
                            </div>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Producción </a>
                            <div class="dropdown-menu p-3" style="min-width: 420px;">
                                <div class="row">
                                    <div class="col-6">
                                        <a class="dropdown-item" href="@Url.Action("Index","Produccion")">Producción</a>
                                        <a class="dropdown-item" href="@Url.Action("Index","IngresoHilo")">Ingreso Hilo</a>
                                        <a class="dropdown-item" href="@Url.Action("Index","SalidaHilo")">Salida Hilo</a>
                                        <a class="dropdown-item" href="@Url.Action("Index","Maquina")">Máquina</a>
                                        <a class="dropdown-item" href="@Url.Action("Index","MantenimientoMaquina")">Mantenimiento Máquina</a>
                                        <a class="dropdown-item" href="@Url.Action("Index","AsistenciaOperario")">Asistencia Operario</a>
                                    </div>
                                </div>
                            </div>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Despacho </a>
                            <div class="dropdown-menu p-3" style="min-width: 420px;">
                                <div class="row">
                                    <div class="col-6">
                                        <a class="dropdown-item" href="@Url.Action("Index","Entrega")">Entrega</a>
                                        <a class="dropdown-item" href="@Url.Action("Index","CobranzaPedido")">Cobranza Pedido</a>
                                    </div>
                                </div>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
        @*fin del menu*@
        <div class="mb-3"></div>


        @*inicio del cuerpo de la pagina*@
        <div class="container body-content">
            @RenderBody()
        </div>

        @*fin del cuerpo de la pagina*@
        <footer>
            <p>&copy; @DateTime.Now.Year - <span>CiberElectrik</span> </p>
        </footer>
    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>