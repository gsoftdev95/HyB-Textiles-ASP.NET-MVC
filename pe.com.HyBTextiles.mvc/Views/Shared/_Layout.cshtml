<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> HyB Textil | @ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <style>
        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        
        .container {
            display: flex;
            flex-direction: column;
            flex: 1;
        }

        .body-content {
            flex: 1;
        }

        footer {
            background-color: #212529;
            color: #FFFFFF;
            text-align: center;
            padding: 5px 0;
            width: 100%
        }
    </style>
</head>
<body>

    <div class="container body">
        @*inicio del menu*@
        <nav class="navbar navbar-expand-lg bg-dark" data-bs-theme="dark">
            <div class="container-fluid">
                @Html.ActionLink("HyB Textil", "Index", "Inicio", null, new { @class = "navbar-brand" })
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavDropdown" aria-controls="navbarNavDropdown" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNavDropdown">
                    <ul class="navbar-nav">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Configuración </a>
                            <div class="dropdown-menu p-3" style="min-width: 420px;">
                                <div class="row">
                                    <div class="col-6">
                                        @Html.ActionLink("Rol", "Index", "Rol", null, new { @class = "dropdown-item" })
                                        @Html.ActionLink("Usuario", "Index", "Usuario", null, new { @class = "dropdown-item" })
                                        @Html.ActionLink("Permiso", "Index", "Permiso", null, new { @class = "dropdown-item" })
                                        @Html.ActionLink("Rol Permiso", "Index", "RolPermiso", null, new { @class = "dropdown-item" })
                                        @Html.ActionLink("Tipo Documento", "Index", "TipoDocumento", null, new { @class = "dropdown-item" })
                                    </div>
                                </div>
                            </div>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Datos Generales </a>
                            <div class="dropdown-menu p-3" style="min-width: 420px;">
                                @Html.ActionLink("Cliente", "Index", "Cliente", null, new { @class = "dropdown-item" })
                                @Html.ActionLink("Proveedor", "Index", "Proveedor", null, new { @class = "dropdown-item" })
                                @Html.ActionLink("Operario", "Index", "Operario", null, new { @class = "dropdown-item" })
                                @Html.ActionLink("Moneda", "Index", "Moneda", null, new { @class = "dropdown-item" })
                                @Html.ActionLink("Unidad de Medida", "Index", "UnidadMedida", null, new { @class = "dropdown-item" })
                                @Html.ActionLink("Almacén", "Index", "Almacen", null, new { @class = "dropdown-item" })
                                @Html.ActionLink("Turno", "Index", "Turno", null, new { @class = "dropdown-item" })
                                @Html.ActionLink("Tipo Hilo", "Index", "TipoHilo", null, new { @class = "dropdown-item" })
                                @Html.ActionLink("Tipo Tejido", "Index", "TipoTejido", null, new { @class = "dropdown-item" })
                            </div>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Pedidos </a>
                            <div class="dropdown-menu p-3" style="min-width: 420px;">
                                @Html.ActionLink("Pedido", "Index", "Pedido", null, new { @class = "dropdown-item" })
                                @Html.ActionLink("Estado Pedido", "Index", "EstadoPedido", null, new { @class = "dropdown-item" })
                                @Html.ActionLink("Historial Estado", "Index", "HistorialEstadoPedido", null, new { @class = "dropdown-item" })
                                @Html.ActionLink("Documento Pedido", "Index", "DocumentoPedido", null, new { @class = "dropdown-item" })
                            </div>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Compras </a>
                            <div class="dropdown-menu p-3" style="min-width: 420px;">
                                <div class="row">
                                    <div class="col-6">
                                        @Html.ActionLink("Compra Proveedor", "Index", "CompraProveedor", null, new { @class = "dropdown-item" })
                                        @Html.ActionLink("Pago Proveedor", "Index", "PagoProveedor", null, new { @class = "dropdown-item" })
                                    </div>
                                </div>
                            </div>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Producción </a>
                            <div class="dropdown-menu p-3" style="min-width: 420px;">
                                <div class="row">
                                    <div class="col-6">
                                        @Html.ActionLink("Producción", "Index", "Produccion", null, new { @class = "dropdown-item" })
                                        @Html.ActionLink("Ingreso Hilo", "Index", "IngresoHilo", null, new { @class = "dropdown-item" })
                                        @Html.ActionLink("Salida Hilo", "Index", "SalidaHilo", null, new { @class = "dropdown-item" })
                                        @Html.ActionLink("Máquina", "Index", "Maquina", null, new { @class = "dropdown-item" })
                                        @Html.ActionLink("Mantenimiento Máquina", "Index", "MantenimientoMaquina", null, new { @class = "dropdown-item" })
                                        @Html.ActionLink("Asistencia Operario", "Index", "AsistenciaOperario", null, new { @class = "dropdown-item" })
                                    </div>
                                </div>
                            </div>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Despacho </a>
                            <div class="dropdown-menu p-3" style="min-width: 420px;">
                                <div class="row">
                                    <div class="col-6">
                                        @Html.ActionLink("Entrega", "Index", "Entrega", null, new { @class = "dropdown-item" })
                                        @Html.ActionLink("Cobranza Pedido", "Index", "CobranzaPedido", null, new { @class = "dropdown-item" })
                                    </div>
                                </div>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
        @*fin del menu*@
        <div class="mb-3"></div>


        @*inicio del cuerpo de la pagina*@
        <div class="container body-content">
            @RenderBody()
        </div>

        @*fin del cuerpo de la pagina*@
        <footer>
            <p>&copy; @DateTime.Now.Year - <span>HyB Textil S.A.C.</span> </p>
        </footer>
    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>