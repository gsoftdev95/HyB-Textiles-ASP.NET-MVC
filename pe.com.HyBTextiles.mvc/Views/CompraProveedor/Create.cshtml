@model pe.com.HyBTextiles.mvc.Models.CompraProveedor

@{
    ViewBag.Title = "Registrar CompraProveedor";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center"><div class="col-md-8">
        <div class="card shadow border-0">
            <div class="card-header bg-primary text-white"><h4 class="mb-0">Registrar CompraProveedor</h4></div>
            <div class="card-body">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                        <div class="mb-3">
                            @Html.LabelFor(model => model.feccom, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.EditorFor(model => model.feccom, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.feccom, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.codprv, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.DropDownList("codprv", (SelectList)ViewBag.codprv, "-- Seleccione --", new { @class = "form-select" })
                            @Html.ValidationMessageFor(model => model.codprv, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.codmon, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.DropDownList("codmon", (SelectList)ViewBag.codmon, "-- Seleccione --", new { @class = "form-select" })
                            @Html.ValidationMessageFor(model => model.codmon, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.codusu, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.DropDownList("codusu", (SelectList)ViewBag.codusu, "-- Seleccione --", new { @class = "form-select" })
                            @Html.ValidationMessageFor(model => model.codusu, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.totcom, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.EditorFor(model => model.totcom, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.totcom, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.estcom, htmlAttributes: new { @class = "form-label fw-bold" })
                            <div class="form-check form-switch">
                                @Html.CheckBoxFor(model => model.estcom, new { @class = "form-check-input" })
                                <label class="form-check-label">Habilitado</label>
                            </div>
                        </div>
                    <div class="d-flex justify-content-between mt-3">
                        <button type="submit" class="btn btn-primary">Registrar CompraProveedor</button>
                        @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-dark" })
                    </div>
                }
            </div>
            <div class="card-footer text-muted text-center">HyB Textiles - CompraProveedor</div>
        </div>
    </div></div>
</div>