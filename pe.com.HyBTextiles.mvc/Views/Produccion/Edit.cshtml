@model pe.com.HyBTextiles.mvc.Models.Produccion

@{
    ViewBag.Title = "Actualizar Produccion";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center"><div class="col-md-8">
        <div class="card shadow border-0">
            <div class="card-header bg-success text-white"><h4 class="mb-0">Actualizar Produccion</h4></div>
            <div class="card-body">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                    @Html.HiddenFor(model => model.codpro)
                        <div class="mb-3">
                            @Html.LabelFor(model => model.fecpro, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.EditorFor(model => model.fecpro, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.fecpro, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.codmaq, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.DropDownList("codmaq", (SelectList)ViewBag.codmaq, "-- Seleccione --", new { @class = "form-select" })
                            @Html.ValidationMessageFor(model => model.codmaq, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.codope, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.DropDownList("codope", (SelectList)ViewBag.codope, "-- Seleccione --", new { @class = "form-select" })
                            @Html.ValidationMessageFor(model => model.codope, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.codtte, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.DropDownList("codtte", (SelectList)ViewBag.codtte, "-- Seleccione --", new { @class = "form-select" })
                            @Html.ValidationMessageFor(model => model.codtte, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.codped, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.DropDownList("codped", (SelectList)ViewBag.codped, "-- Seleccione --", new { @class = "form-select" })
                            @Html.ValidationMessageFor(model => model.codped, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.canpro, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.EditorFor(model => model.canpro, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.canpro, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.estpro, htmlAttributes: new { @class = "form-label fw-bold" })
                            <div class="form-check form-switch">
                                @Html.CheckBoxFor(model => model.estpro, new { @class = "form-check-input" })
                                <label class="form-check-label">Habilitado</label>
                            </div>
                        </div>
                    <div class="d-flex justify-content-between mt-3">
                        <button type="submit" class="btn btn-success">Actualizar Produccion</button>
                        @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-dark" })
                    </div>
                }
            </div>
            <div class="card-footer text-muted text-center">HyB Textiles - Produccion</div>
        </div>
    </div></div>
</div>