@model pe.com.HyBTextiles.mvc.Models.IngresoHilo

@{
    ViewBag.Title = "Actualizar IngresoHilo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center"><div class="col-md-8">
        <div class="card shadow border-0">
            <div class="card-header bg-success text-white"><h4 class="mb-0">Actualizar IngresoHilo</h4></div>
            <div class="card-body">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                    @Html.HiddenFor(model => model.coding)
                        <div class="mb-3">
                            @Html.LabelFor(model => model.fecing, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.EditorFor(model => model.fecing, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.fecing, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.codthi, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.DropDownList("codthi", (SelectList)ViewBag.codthi, "-- Seleccione --", new { @class = "form-select" })
                            @Html.ValidationMessageFor(model => model.codthi, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.codalm, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.DropDownList("codalm", (SelectList)ViewBag.codalm, "-- Seleccione --", new { @class = "form-select" })
                            @Html.ValidationMessageFor(model => model.codalm, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.codund, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.DropDownList("codund", (SelectList)ViewBag.codund, "-- Seleccione --", new { @class = "form-select" })
                            @Html.ValidationMessageFor(model => model.codund, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.codcom, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.DropDownList("codcom", (SelectList)ViewBag.codcom, "-- Seleccione --", new { @class = "form-select" })
                            @Html.ValidationMessageFor(model => model.codcom, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.caning, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.EditorFor(model => model.caning, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.caning, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.esting, htmlAttributes: new { @class = "form-label fw-bold" })
                            <div class="form-check form-switch">
                                @Html.CheckBoxFor(model => model.esting, new { @class = "form-check-input" })
                                <label class="form-check-label">Habilitado</label>
                            </div>
                        </div>
                    <div class="d-flex justify-content-between mt-3">
                        <button type="submit" class="btn btn-success">Actualizar IngresoHilo</button>
                        @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-dark" })
                    </div>
                }
            </div>
            <div class="card-footer text-muted text-center">HyB Textiles - IngresoHilo</div>
        </div>
    </div></div>
</div>