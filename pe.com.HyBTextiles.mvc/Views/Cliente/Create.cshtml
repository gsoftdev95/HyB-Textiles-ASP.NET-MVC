@model pe.com.HyBTextiles.mvc.Models.Cliente

@{
    ViewBag.Title = "Registrar Cliente";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center"><div class="col-md-8">
        <div class="card shadow border-0">
            <div class="card-header bg-primary text-white"><h4 class="mb-0">Registrar Cliente</h4></div>
            <div class="card-body">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                        <div class="mb-3">
                            @Html.LabelFor(model => model.ruccli, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.EditorFor(model => model.ruccli, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.ruccli, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.razonsocialcli, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.EditorFor(model => model.razonsocialcli, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.razonsocialcli, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.nomcontactocli, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.EditorFor(model => model.nomcontactocli, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.nomcontactocli, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.telcli, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.EditorFor(model => model.telcli, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.telcli, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.emacli, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.EditorFor(model => model.emacli, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.emacli, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.dircli, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.EditorFor(model => model.dircli, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.dircli, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.estcli, htmlAttributes: new { @class = "form-label fw-bold" })
                            <div class="form-check form-switch">
                                @Html.CheckBoxFor(model => model.estcli, new { @class = "form-check-input" })
                                <label class="form-check-label">Habilitado</label>
                            </div>
                        </div>
                    <div class="d-flex justify-content-between mt-3">
                        <button type="submit" class="btn btn-primary">Registrar Cliente</button>
                        @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-dark" })
                    </div>
                }
            </div>
            <div class="card-footer text-muted text-center">HyB Textiles - Cliente</div>
        </div>
    </div></div>
</div>