@model pe.com.HyBTextiles.mvc.Models.Moneda

@{
    ViewBag.Title = "Habilitación de Moneda";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4"><div class="card shadow border-0">
    <div class="card-header bg-warning text-white"><h4 class="mb-0">Habilitación de Moneda</h4></div>
    <div class="card-body">
        <div class="alert alert-warning">¿Estás seguro que deseas habilitar este registro?</div>
        <dl class="row">
            <dt class="col-sm-3">Código</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.codmon)</dd>
            <dt class="col-sm-3">Nombre Moneda</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.nommon)</dd>
            <dt class="col-sm-3">Símbolo</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.simbmon)</dd>
            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">@(Model.estmon ? "Habilitado" : "Deshabilitado")</dd>
        </dl>
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <div class="d-flex justify-content-between">
                <button type="submit" class="btn btn-warning">Habilitar</button>
                @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-dark" })
            </div>
        }
    </div>
    <div class="card-footer text-muted text-center">HyB Textiles - Moneda</div>
</div></div>