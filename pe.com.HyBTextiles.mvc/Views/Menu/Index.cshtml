
@{
    ViewBag.Title = "Menu Principal";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>HyB Textiles</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: #f5f6fa;
        }

        .navbar {
            background: #1f2937;
        }

        .navbar-brand {
            font-weight: bold;
        }

        .card-menu {
            transition: .3s;
            border: none;
            border-radius: 15px;
        }

            .card-menu:hover {
                transform: translateY(-5px);
                box-shadow: 0px 10px 25px rgba(0,0,0,.15);
            }

        .card-header {
            font-weight: bold;
            text-align: center;
            color: white;
        }

        .list-group-item:hover {
            background: #f0f0f0;
        }

        footer {
            margin-top: 40px;
            padding: 15px;
            background: #212529;
            color: white;
            text-align: center;
        }
    </style>

</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">

            <a class="navbar-brand" href="#">
                HyB Textiles
            </a>

            <div class="ms-auto">

                <span class="text-white me-3">
                    Bienvenido:
                    <strong>@Session["usuemp"]</strong>
                </span>

                <a href="@Url.Action("CerrarSesion","Inicio")"
                   class="btn btn-danger">
                    Cerrar sesión
                </a>

            </div>

        </div>
    </nav>

    <div class="container mt-5">

        <h2 class="text-center mb-4">
            Sistema de Gestión HyB Textiles
        </h2>

        <div class="row g-4">

            <!-- Mantenimientos -->

            <div class="col-md-4">

                <div class="card card-menu h-100">

                    <div class="card-header bg-primary">
                        Mantenimientos
                    </div>

                    <div class="list-group list-group-flush">

                        <a href="@Url.Action("Index","Rol")" class="list-group-item">
                            Rol
                        </a>

                        <a href="@Url.Action("Index","TipoDocumento")" class="list-group-item">
                            Tipo Documento
                        </a>

                        <a href="@Url.Action("Index","Moneda")" class="list-group-item">
                            Moneda
                        </a>

                        <a href="@Url.Action("Index","Cliente")" class="list-group-item">
                            Cliente
                        </a>

                        <a href="@Url.Action("Index","Proveedor")" class="list-group-item">
                            Proveedor
                        </a>

                        <a href="@Url.Action("Index","Usuario")" class="list-group-item">
                            Usuario
                        </a>

                    </div>

                </div>

            </div>

            <!-- Producción -->

            <div class="col-md-4">

                <div class="card card-menu h-100">

                    <div class="card-header bg-success">
                        Producción
                    </div>

                    <div class="list-group list-group-flush">

                        <a href="@Url.Action("Index","Produccion")" class="list-group-item">
                            Producción
                        </a>

                        <a href="@Url.Action("Index","SalidaHilo")" class="list-group-item">
                            Salida de Hilo
                        </a>

                        <a href="@Url.Action("Index","IngresoHilo")" class="list-group-item">
                            Ingreso de Hilo
                        </a>

                    </div>

                </div>

            </div>

            <!-- Compras y Ventas -->

            <div class="col-md-4">

                <div class="card card-menu h-100">

                    <div class="card-header bg-warning text-dark">
                        Compras y Pedidos
                    </div>

                    <div class="list-group list-group-flush">

                        <a href="@Url.Action("Index","CompraProveedor")" class="list-group-item">
                            Compra Proveedor
                        </a>

                        <a href="@Url.Action("Index","Pedido")" class="list-group-item">
                            Pedido
                        </a>

                        <a href="@Url.Action("Index","Entrega")" class="list-group-item">
                            Entrega
                        </a>

                        <a href="@Url.Action("Index","CobranzaPedido")" class="list-group-item">
                            Cobranza
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>


</body>
</html>