@model pe.com.HyBTextiles.mvc.Models.DocumentoPedido

@{
    ViewBag.Title = "Detalle de DocumentoPedido";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4"><div class="card shadow border-0">
    <div class="card-header bg-dark text-white"><h4 class="mb-0">Detalle de DocumentoPedido</h4></div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Código</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.coddoc)</dd>
            <dt class="col-sm-3">Pedido</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.codped)</dd>
            <dt class="col-sm-3">Tipo Documento</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.codtdo)</dd>
            <dt class="col-sm-3">Número Documento</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.numdoc)</dd>
            <dt class="col-sm-3">Fecha Documento</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.fecdoc)</dd>
            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">@(Model.estdoc ? "Habilitado" : "Deshabilitado")</dd>
        </dl>
        @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-dark" })
    </div>
    <div class="card-footer text-muted text-center">HyB Textiles - DocumentoPedido</div>
</div></div>