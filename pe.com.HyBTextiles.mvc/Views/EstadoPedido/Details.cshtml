@model pe.com.HyBTextiles.mvc.Models.EstadoPedido

@{
    ViewBag.Title = "Detalle de EstadoPedido";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4"><div class="card shadow border-0">
    <div class="card-header bg-dark text-white"><h4 class="mb-0">Detalle de EstadoPedido</h4></div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Código</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.codest)</dd>
            <dt class="col-sm-3">Estado Pedido</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.nomest)</dd>
            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">@(Model.estest ? "Habilitado" : "Deshabilitado")</dd>
        </dl>
        @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-dark" })
    </div>
    <div class="card-footer text-muted text-center">HyB Textiles - EstadoPedido</div>
</div></div>