@model pe.com.HyBTextiles.mvc.Models.Entrega

@{
    ViewBag.Title = "Detalle de Entrega";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4"><div class="card shadow border-0">
    <div class="card-header bg-dark text-white"><h4 class="mb-0">Detalle de Entrega</h4></div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Código</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.codent)</dd>
            <dt class="col-sm-3">Fecha Entrega</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.fecent)</dd>
            <dt class="col-sm-3">Pedido</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.codped)</dd>
            <dt class="col-sm-3">Responsable Entrega</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.respent)</dd>
            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">@(Model.estent ? "Habilitado" : "Deshabilitado")</dd>
        </dl>
        @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-dark" })
    </div>
    <div class="card-footer text-muted text-center">HyB Textiles - Entrega</div>
</div></div>