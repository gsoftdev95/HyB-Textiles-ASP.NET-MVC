@model pe.com.HyBTextiles.mvc.Models.Turno

@{
    ViewBag.Title = "Detalle de Turno";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4"><div class="card shadow border-0">
    <div class="card-header bg-dark text-white"><h4 class="mb-0">Detalle de Turno</h4></div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Código</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.codtur)</dd>
            <dt class="col-sm-3">Nombre Turno</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.nomtur)</dd>
            <dt class="col-sm-3">Hora Inicio</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.horainitur)</dd>
            <dt class="col-sm-3">Hora Fin</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.horafintur)</dd>
            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">@(Model.esttur ? "Habilitado" : "Deshabilitado")</dd>
        </dl>
        @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-dark" })
    </div>
    <div class="card-footer text-muted text-center">HyB Textiles - Turno</div>
</div></div>