@model pe.com.HyBTextiles.mvc.Models.HistorialEstadoPedido

@{
    ViewBag.Title = "Registrar HistorialEstadoPedido";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center"><div class="col-md-8">
        <div class="card shadow border-0">
            <div class="card-header bg-primary text-white"><h4 class="mb-0">Registrar HistorialEstadoPedido</h4></div>
            <div class="card-body">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                        <div class="mb-3">
                            @Html.LabelFor(model => model.codped, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.DropDownList("codped", (SelectList)ViewBag.codped, "-- Seleccione --", new { @class = "form-select" })
                            @Html.ValidationMessageFor(model => model.codped, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.codest, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.DropDownList("codest", (SelectList)ViewBag.codest, "-- Seleccione --", new { @class = "form-select" })
                            @Html.ValidationMessageFor(model => model.codest, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.codusu, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.DropDownList("codusu", (SelectList)ViewBag.codusu, "-- Seleccione --", new { @class = "form-select" })
                            @Html.ValidationMessageFor(model => model.codusu, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.fechis, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.EditorFor(model => model.fechis, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.fechis, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.esthis, htmlAttributes: new { @class = "form-label fw-bold" })
                            <div class="form-check form-switch">
                                @Html.CheckBoxFor(model => model.esthis, new { @class = "form-check-input" })
                                <label class="form-check-label">Habilitado</label>
                            </div>
                        </div>
                    <div class="d-flex justify-content-between mt-3">
                        <button type="submit" class="btn btn-primary">Registrar HistorialEstadoPedido</button>
                        @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-dark" })
                    </div>
                }
            </div>
            <div class="card-footer text-muted text-center">HyB Textiles - HistorialEstadoPedido</div>
        </div>
    </div></div>
</div>