@model pe.com.HyBTextiles.mvc.Models.HistorialEstadoPedido

@{
    ViewBag.Title = "Detalle de HistorialEstadoPedido";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4"><div class="card shadow border-0">
    <div class="card-header bg-dark text-white"><h4 class="mb-0">Detalle de HistorialEstadoPedido</h4></div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Código</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.codhis)</dd>
            <dt class="col-sm-3">Pedido</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.codped)</dd>
            <dt class="col-sm-3">Estado Pedido</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.codest)</dd>
            <dt class="col-sm-3">Usuario</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.codusu)</dd>
            <dt class="col-sm-3">Fecha Historial</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.fechis)</dd>
            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">@(Model.esthis ? "Habilitado" : "Deshabilitado")</dd>
        </dl>
        @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-dark" })
    </div>
    <div class="card-footer text-muted text-center">HyB Textiles - HistorialEstadoPedido</div>
</div></div>