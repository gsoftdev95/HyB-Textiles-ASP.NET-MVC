@model pe.com.HyBTextiles.mvc.Models.RolPermiso

@{
    ViewBag.Title = "Detalle de RolPermiso";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4"><div class="card shadow border-0">
    <div class="card-header bg-dark text-white"><h4 class="mb-0">Detalle de RolPermiso</h4></div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Código</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.codrolper)</dd>
            <dt class="col-sm-3">Código Rol</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.codrol)</dd>
            <dt class="col-sm-3">Código Permiso</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.codper)</dd>
            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">@(Model.estrolper ? "Habilitado" : "Deshabilitado")</dd>
        </dl>
        @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-dark" })
    </div>
    <div class="card-footer text-muted text-center">HyB Textiles - RolPermiso</div>
</div></div>