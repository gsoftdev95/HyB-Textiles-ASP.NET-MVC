@model pe.com.HyBTextiles.mvc.Models.RolPermiso

@{
    ViewBag.Title = "Actualizar RolPermiso";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center"><div class="col-md-8">
        <div class="card shadow border-0">
            <div class="card-header bg-success text-white"><h4 class="mb-0">Actualizar RolPermiso</h4></div>
            <div class="card-body">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                    @Html.HiddenFor(model => model.codrolper)
                        <div class="mb-3">
                            @Html.LabelFor(model => model.codrol, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.DropDownList("codrol", (SelectList)ViewBag.codrol, "-- Seleccione --", new { @class = "form-select" })
                            @Html.ValidationMessageFor(model => model.codrol, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.codper, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.DropDownList("codper", (SelectList)ViewBag.codper, "-- Seleccione --", new { @class = "form-select" })
                            @Html.ValidationMessageFor(model => model.codper, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.estrolper, htmlAttributes: new { @class = "form-label fw-bold" })
                            <div class="form-check form-switch">
                                @Html.CheckBoxFor(model => model.estrolper, new { @class = "form-check-input" })
                                <label class="form-check-label">Habilitado</label>
                            </div>
                        </div>
                    <div class="d-flex justify-content-between mt-3">
                        <button type="submit" class="btn btn-success">Actualizar RolPermiso</button>
                        @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-dark" })
                    </div>
                }
            </div>
            <div class="card-footer text-muted text-center">HyB Textiles - RolPermiso</div>
        </div>
    </div></div>
</div>