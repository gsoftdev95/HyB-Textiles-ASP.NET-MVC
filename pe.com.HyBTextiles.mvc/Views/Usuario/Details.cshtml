@model pe.com.HyBTextiles.mvc.Models.Usuario

@{
    ViewBag.Title = "Detalle de Usuario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4"><div class="card shadow border-0">
    <div class="card-header bg-dark text-white"><h4 class="mb-0">Detalle de Usuario</h4></div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Código</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.codusu)</dd>
            <dt class="col-sm-3">Nombre Usuario</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.nomusu)</dd>
            <dt class="col-sm-3">Usuario</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.userusu)</dd>
            <dt class="col-sm-3">Clave</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.claveusu)</dd>
            <dt class="col-sm-3">Código Rol</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.codrol)</dd>
            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">@(Model.estusu ? "Habilitado" : "Deshabilitado")</dd>
        </dl>
        @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-dark" })
    </div>
    <div class="card-footer text-muted text-center">HyB Textiles - Usuario</div>
</div></div>