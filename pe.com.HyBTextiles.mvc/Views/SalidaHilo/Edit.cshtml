@model pe.com.HyBTextiles.mvc.Models.SalidaHilo

@{
    ViewBag.Title = "Actualizar SalidaHilo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center"><div class="col-md-8">
        <div class="card shadow border-0">
            <div class="card-header bg-success text-white"><h4 class="mb-0">Actualizar SalidaHilo</h4></div>
            <div class="card-body">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                    @Html.HiddenFor(model => model.codsal)
                        <div class="mb-3">
                            @Html.LabelFor(model => model.fecsal, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.EditorFor(model => model.fecsal, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.fecsal, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.codpro, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.DropDownList("codpro", (SelectList)ViewBag.codpro, "-- Seleccione --", new { @class = "form-select" })
                            @Html.ValidationMessageFor(model => model.codpro, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.codthi, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.DropDownList("codthi", (SelectList)ViewBag.codthi, "-- Seleccione --", new { @class = "form-select" })
                            @Html.ValidationMessageFor(model => model.codthi, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.codund, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.DropDownList("codund", (SelectList)ViewBag.codund, "-- Seleccione --", new { @class = "form-select" })
                            @Html.ValidationMessageFor(model => model.codund, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.cansal, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.EditorFor(model => model.cansal, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.cansal, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.estsal, htmlAttributes: new { @class = "form-label fw-bold" })
                            <div class="form-check form-switch">
                                @Html.CheckBoxFor(model => model.estsal, new { @class = "form-check-input" })
                                <label class="form-check-label">Habilitado</label>
                            </div>
                        </div>
                    <div class="d-flex justify-content-between mt-3">
                        <button type="submit" class="btn btn-success">Actualizar SalidaHilo</button>
                        @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-dark" })
                    </div>
                }
            </div>
            <div class="card-footer text-muted text-center">HyB Textiles - SalidaHilo</div>
        </div>
    </div></div>
</div>