@model pe.com.HyBTextiles.mvc.Models.SalidaHilo

@{
    ViewBag.Title = "Detalle de SalidaHilo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4"><div class="card shadow border-0">
    <div class="card-header bg-dark text-white"><h4 class="mb-0">Detalle de SalidaHilo</h4></div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Código</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.codsal)</dd>
            <dt class="col-sm-3">Fecha Salida</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.fecsal)</dd>
            <dt class="col-sm-3">Producción</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.codpro)</dd>
            <dt class="col-sm-3">Tipo Hilo</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.codthi)</dd>
            <dt class="col-sm-3">Unidad Medida</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.codund)</dd>
            <dt class="col-sm-3">Cantidad Salida</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.cansal)</dd>
            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">@(Model.estsal ? "Habilitado" : "Deshabilitado")</dd>
        </dl>
        @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-dark" })
    </div>
    <div class="card-footer text-muted text-center">HyB Textiles - SalidaHilo</div>
</div></div>