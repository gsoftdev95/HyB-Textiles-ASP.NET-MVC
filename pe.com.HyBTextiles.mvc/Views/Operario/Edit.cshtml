@model pe.com.HyBTextiles.mvc.Models.Operario

@{
    ViewBag.Title = "Actualizar Operario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center"><div class="col-md-8">
        <div class="card shadow border-0">
            <div class="card-header bg-success text-white"><h4 class="mb-0">Actualizar Operario</h4></div>
            <div class="card-body">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                    @Html.HiddenFor(model => model.codope)
                        <div class="mb-3">
                            @Html.LabelFor(model => model.nomope, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.EditorFor(model => model.nomope, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.nomope, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.docope, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.EditorFor(model => model.docope, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.docope, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.telope, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.EditorFor(model => model.telope, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.telope, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(model => model.estope, htmlAttributes: new { @class = "form-label fw-bold" })
                            <div class="form-check form-switch">
                                @Html.CheckBoxFor(model => model.estope, new { @class = "form-check-input" })
                                <label class="form-check-label">Habilitado</label>
                            </div>
                        </div>
                    <div class="d-flex justify-content-between mt-3">
                        <button type="submit" class="btn btn-success">Actualizar Operario</button>
                        @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-dark" })
                    </div>
                }
            </div>
            <div class="card-footer text-muted text-center">HyB Textiles - Operario</div>
        </div>
    </div></div>
</div>